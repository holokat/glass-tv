# Copy these exports into a private shell session or private environment file.
# Do not commit keystores or password files. The script intentionally has no
# default signing identity and never reads build-android.sh's development key.
export GLASSTV_RELEASE_APPLICATION_ID="xyz.glasstv.launcher"
export GLASSTV_RELEASE_KEYSTORE="/absolute/path/to/glasstv-release.p12"
export GLASSTV_RELEASE_KEY_ALIAS="glasstv-release"
export GLASSTV_RELEASE_STORE_PASSWORD_FILE="/absolute/path/to/store-password"
export GLASSTV_RELEASE_KEY_PASSWORD_FILE="/absolute/path/to/key-password"
